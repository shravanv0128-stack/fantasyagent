# ESPN private-league auth. Get these from your browser while logged in to
# fantasy.espn.com: DevTools -> Application -> Cookies -> https://fantasy.espn.com
#   SWID     looks like {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}  (keep the braces)
#   espn_s2  is a long URL-encoded string
ESPN_SWID={00000000-0000-0000-0000-000000000000}
ESPN_S2=

# Optional: post the weekly proposal to a Slack incoming webhook.
FANTASY_SLACK_WEBHOOK=
