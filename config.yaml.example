# Copy to config.yaml and fill in. Secrets live in the environment, not here.

# From your league URL: .../leagues/{league_id}
league_id: 123456
season: 2026

# Identify your team by id (from the URL's teamId=) or by name. One is enough.
team_id: 3
# team_name: "My Team Name"

# Do not bother submitting unless the optimized lineup beats the current one
# by at least this many projected points. Keeps the agent from churning the
# roster over rounding noise.
min_gain: 0.5

# Opponent-strength adjustment, computed from points allowed by position.
use_matchup: true
# How hard to lean on it. 0.06 moves a projection by ~6% per standard
# deviation of defensive strength; ESPN projections already price in some
# matchup, so a bigger number double-counts it.
matchup_alpha: 0.06

# Never try to move a player whose game has already kicked off.
respect_locks: true

# Team implied point totals from Vegas lines (ESPN's public scoreboard, no
# key needed). Sharper than "points allowed by position" because it isn't
# confounded by strength of schedule — it prices in both offenses AND both
# defenses for this specific game, refreshed all week as news breaks.
use_vegas: true

# Wind-driven downgrade for outdoor games (Open-Meteo, no key needed). Only
# engages at real severity (15mph+), and only for outdoor stadiums — a
# retractable roof is treated like a dome rather than tracked live, since
# teams close it exactly when weather would otherwise matter.
use_weather: true

# Tilts toward higher-ceiling players when you're a big underdog in your
# matchup this week, and toward steadier players when you're a big favorite.
# Computed from each player's own game-to-game scoring history — no external
# data, just a second look at your opponent's likely lineup.
use_volatility: true

# Where the pending proposal and audit log are written.
state_dir: state

# Email address to send the weekly proposal to. Leave unset to skip email
# entirely (Slack/stdout still work). The Gmail account and app password that
# send it live in the environment (GMAIL_ADDRESS / GMAIL_APP_PASSWORD), not here.
email_to: you@example.com
